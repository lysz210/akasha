services:
  traefik:
    image: traefik:v3.7.1
    command:
      - "--providers.swarm=true"
      - "--providers.swarm.exposedByDefault=false"
      - "--entrypoints.web.address=:80"
    volumes:
      - /run/docker.sock:/var/run/docker.sock:ro
    ports:
      - "80:80"
    networks:
      - akasha_net

networks:
  akasha_net:
    name: {{ shared_net_name }}
    external: true
